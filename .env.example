# Clockwork — environment variables

# API auth token (Bearer token for all requests)
CLOCKWORK_TOKEN=change-me

# Webhook URL for notifications (card moves, retry-exhausted, etc.)
CLOCKWORK_NOTIFY_URL=

# Webhook auth token
CLOCKWORK_NOTIFY_TOKEN=

# Git token for cloning project repos
CLOCKWORK_GIT_TOKEN=

# Frame model for worker invocations (default: frame-low)
PI_MODEL=frame-low
